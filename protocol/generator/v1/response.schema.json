{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapper.dev/protocol/generator/v1/response.schema.json",
  "title": "Mapper generator response v1",
  "type": "object",
  "required": ["protocol", "files"],
  "properties": {
    "protocol": { "const": 1 },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "content"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "content": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
